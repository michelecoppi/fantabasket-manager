# Copiare in .env.local (mai committare). Valori dal progetto Supabase: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Indirizzo pubblico del sito (es. https://xxxx.vercel.app), usato per il link di accesso via email. In locale si può lasciare vuoto.
NEXT_PUBLIC_SITE_URL=
# SOLO per script locali di import; non va mai su Vercel né nel client.
SUPABASE_SERVICE_ROLE_KEY=
# SOLO per psql in locale (Supabase → Connect → Session pooler); non va mai su Vercel né nel client.
SUPABASE_DB_URL=
# Bot Telegram (Fase 7.5), facoltativo: senza, gli scambi non si annunciano. Su Vercel e in .env.local per scripts/telegram-test.ts. Vedi docs/DEPLOY.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Facoltativo: id Telegram degli admin (numeri, separati da virgola) che ricevono in privato le richieste di cambio titolari/riserve.
# Ognuno deve prima aprire il bot e premere Avvia. Vedi docs/DEPLOY.md.
TELEGRAM_ADMIN_ALERT=
# Notifiche push sul telefono (facoltativo: senza, la pagina Account dice che non sono attive). Chiavi con `npx web-push generate-vapid-keys`:
# la pubblica va in NEXT_PUBLIC_VAPID_PUBLIC_KEY (anche su Vercel, si legge a build), la privata solo su Vercel e in .env.local. Vedi docs/DEPLOY.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Facoltativo: contatto per i servizi di notifica (mailto:...). Se manca si usa NEXT_PUBLIC_SITE_URL, che deve essere https.
VAPID_SUBJECT=
